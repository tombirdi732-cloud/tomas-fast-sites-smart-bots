{
  "expo": {
    "name": "Спасай",
    "slug": "spasai",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "spasai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#21A038",
      "resizeMode": "contain"
    },
    "android": {
      "package": "ru.spasai.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#21A038"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "bundleIdentifier": "ru.spasai.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Чтобы показать боксы рядом с вами"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Чтобы показать боксы рядом с вами"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 26,
            "useLegacyPackaging": true
          }
        }
      ],
      [
        "react-native-yamap-plus",
        {
          "android_useYandexMapKitLite": true,
          "ios_useYandexMapKitLite": true
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://tomas-it.ru/api"
    },
    "icon": "./assets/icon.png"
  }
}
