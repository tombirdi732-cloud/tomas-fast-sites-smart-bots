# Окружение для запуска API внутри docker compose (профиль `api`).
# Только для локальной разработки — реальных секретов здесь быть не должно.
NODE_ENV=development
PORT=3000
API_PREFIX=api
DATABASE_URL=postgresql://spasai:spasai@postgres:5432/spasai?schema=public
REDIS_URL=redis://redis:6379
CORS_ORIGINS=*
SMS_STUB=true
S3_ENDPOINT=http://minio:9000
S3_REGION=ru-central1
S3_BUCKET=spasai
S3_ACCESS_KEY=spasai
S3_SECRET_KEY=spasai-secret
