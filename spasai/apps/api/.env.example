# Скопируйте в .env: cp .env.example .env
NODE_ENV=development
PORT=3000
API_PREFIX=api

# PostgreSQL с расширением PostGIS (поднимается через docker compose)
DATABASE_URL="postgresql://spasai:spasai@localhost:5432/spasai?schema=public"

# Redis — кэш и очереди
REDIS_URL="redis://localhost:6379"

# Origins веб-панели и админки через запятую, либо * в dev
CORS_ORIGINS=*

# Провайдер SMS: stub | smsru | smsc
# stub — код всегда 0000, ничего не отправляется. В production запрещён.
SMS_PROVIDER=stub
SMS_API_ID=            # sms.ru
SMS_LOGIN=             # smsc.ru
SMS_PASSWORD=          # smsc.ru
SMS_SENDER=            # согласованное с оператором имя отправителя

# S3-совместимое хранилище (локально — MinIO, в проде — Yandex Object Storage)
S3_ENDPOINT="http://localhost:9000"
S3_REGION=ru-central1
S3_BUCKET=spasai
S3_ACCESS_KEY=spasai
S3_SECRET_KEY=spasai-secret

# ЮKassa (этап 6). Пусто — приём платежей выключен, работает dev-заглушка.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=spasai://payment-result

# Firebase Cloud Messaging (этап 7). Пусто — пуши только пишутся в БД.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Sentry (этап 9). Пусто — трекинг ошибок выключен.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
APP_VERSION=
