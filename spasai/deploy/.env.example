# Боевое окружение. Скопируйте в deploy/.env и заполните.
# Файл .env в git не попадает — там настоящие секреты.

# Домен, на который выпущен сертификат
DOMAIN=spasai.ru

# ── База и Redis ────────────────────────────────────────────────────────────
POSTGRES_USER=spasai
POSTGRES_DB=spasai
# openssl rand -base64 32
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ── Приложение ──────────────────────────────────────────────────────────────
NODE_ENV=production
API_PREFIX=api
CORS_ORIGINS=https://spasai.ru

# openssl rand -base64 48 — каждый свой, не переиспользовать
JWT_SECRET=
AUTH_HASH_SECRET=

# В production обязано быть false, иначе приложение не стартует
SMS_STUB=false

# ── S3 (MinIO на этом же сервере либо Yandex Object Storage) ────────────────
S3_REGION=ru-central1
S3_BUCKET=spasai
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── ЮKassa ──────────────────────────────────────────────────────────────────
# Вебхук настраивается в кабинете: https://spasai.ru/api/webhooks/yookassa
# События: payment.succeeded, payment.canceled, refund.succeeded
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=spasai://payment-result

# ── Пуши (Firebase, файл сервисного аккаунта) ───────────────────────────────
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Приватный ключ одной строкой, переносы как \n
FCM_PRIVATE_KEY=

# ── Логирование ─────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
APP_VERSION=0.1.0
