# Боевое окружение. Скопируйте в deploy/.env и заполните.
# Файл .env в git не попадает — там настоящие секреты.

# Домен, на который выпущен сертификат
DOMAIN=spasai.ru

# ── База и Redis ────────────────────────────────────────────────────────────
POSTGRES_USER=spasai
POSTGRES_DB=spasai
# openssl rand -base64 32
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ── Приложение ──────────────────────────────────────────────────────────────
NODE_ENV=production
API_PREFIX=api
CORS_ORIGINS=https://spasai.ru

# openssl rand -base64 48 — каждый свой, не переиспользовать
JWT_SECRET=
AUTH_HASH_SECRET=

# ── SMS ─────────────────────────────────────────────────────────────────────
# stub в production запрещён — приложение не стартует.
# smsru: нужен SMS_API_ID.  smsc: нужны SMS_LOGIN и SMS_PASSWORD.
SMS_PROVIDER=smsru
SMS_API_ID=
SMS_LOGIN=
SMS_PASSWORD=
# Имя отправителя согласуется с оператором заранее, иначе придёт с общего номера
SMS_SENDER=

# Вход без номера и кода (POST /auth/demo) — временная мера, пока SMS не работают.
# Заводит только новый пустой аккаунт, чужой им не открыть.
# Выключите (false), как только заработает рассылка.
DEMO_LOGIN=true

# ── S3 (Yandex Object Storage; MinIO — только если подняли профиль storage) ─
# Для Object Storage: https://storage.yandexcloud.net
# Для локального MinIO:  http://minio:9000
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=spasai
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── ЮKassa ──────────────────────────────────────────────────────────────────
# Вебхук настраивается в кабинете: https://spasai.ru/api/webhooks/yookassa
# События: payment.succeeded, payment.canceled, refund.succeeded
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=spasai://payment-result

# ── Пуши (Firebase, файл сервисного аккаунта) ───────────────────────────────
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Приватный ключ одной строкой, переносы как \n
FCM_PRIVATE_KEY=

# ── Логирование ─────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
APP_VERSION=0.1.0
